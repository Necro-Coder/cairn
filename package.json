{
  "name": "cairn",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:mock": "vite --mode preview",
    "build:preview": "vite build --mode preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**\" \"src-isolation/**\" \"scripts/**\" \"tests/**\" \"docs/**\" \"./*.{json,html,ts,js}\" README.md SECURITY.md CONTRIBUTING.md CHANGELOG.md",
    "format:check": "prettier --check \"src/**\" \"src-isolation/**\" \"scripts/**\" \"tests/**\" \"docs/**\" \"./*.{json,html,ts,js}\" README.md SECURITY.md CONTRIBUTING.md CHANGELOG.md",
    "knip": "knip",
    "test:unit": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "tokens": "node scripts/check-tokens.mjs",
    "test:a11y": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/cli": "2.12.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
