{
  "name": "cairn",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write \"src/**\" \"src-isolation/**\" \"docs/**\" \"./*.{json,html,ts,js}\" README.md SECURITY.md CONTRIBUTING.md CHANGELOG.md",
    "format:check": "prettier --check \"src/**\" \"src-isolation/**\" \"docs/**\" \"./*.{json,html,ts,js}\" README.md SECURITY.md CONTRIBUTING.md CHANGELOG.md",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@tsconfig/svelte": "5.0.8",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "knip": "6.35.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
