# Editor defaults shared by every contributor, so that formatting never shows up in a diff.
# The authoritative formatters are rustfmt and Prettier; this file only covers what they do not.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
# Trailing whitespace is not meaningful here: this project never uses two-space line breaks.
trim_trailing_whitespace = true

[Makefile]
indent_style = tab
