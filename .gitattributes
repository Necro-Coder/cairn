# Normalise every text file to LF in the repository.
# Without this a clone on Windows and a clone on Linux disagree about every line,
# and the CI runners produce a diff against a tree nobody changed.
* text=auto eol=lf

# Binary files: never normalised, never diffed as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.icns   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.pdf    binary
*.exe    binary
*.dll    binary
*.ipa    binary

# Frozen test vaults. These are exact byte sequences that a parser has to accept, and the
# line ending normalisation above would rewrite any 0x0d 0x0a pair inside one of them.
*.header binary
*.sealed binary

# Lockfiles are generated. Collapse them in review and keep them out of language stats.
Cargo.lock        linguist-generated=true
package-lock.json linguist-generated=true
